{
  "name": "growsense",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "supabase"
  ],
  "scripts": {
    "dev:pwa": "npm run dev -w @growsense/pwa",
    "dev:web": "npm run dev -w @growsense/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
